tbl_spacing <- tibble::tibble(
y = c(rep(3, 6), seq(3.5, 6, by = 0.5)),
x = c(seq(0.5, 3, by = 0.5), rep(3, 6)))
radius_values <- seq(5, 50, by = 0.1)
results <- list()
for (i in 1:nrow(tbl_spacing)) {
iter <- glue('Iteracao y: {as.numeric(tbl_spacing[i,"y"])} e x: {(tbl_spacing[i,"x"])}')
results[[iter]] <- circ_density(
radius_values = radius_values,
spacing_x = as.numeric(tbl_spacing[i,'x']),
spacing_y = as.numeric(tbl_spacing[i,'y']))
}
# Plot all methodologies with multiple error envelopes
circ_plot_density_error(results[[iter]],
colors = c(
"central" = "#e41a1c",
"vertical" = "#377eb8",
"horizontal" = "black",
"quadrante" = "#4daf4a"
),
error_bands = error_bands,
y_limits = c(-60, 60),
x_min = 5
)
# Plot all methodologies with multiple error envelopes
circ_plot_density_error(results[[iter]],
colors = c(
"central" = "#e41a1c",
"vertical" = "#377eb8",
"horizontal" = "black",
"quadrante" = "#4daf4a"
),
error_bands = error_bands,
y_limits = c(-60, 60))
min_radius_df <- circ_min_radius_for_error(results[[iter]], error_bands)
View(min_radius_df)
for (i in 11:nrow(tbl_spacing)) {
iter <- glue('Iteracao y: {as.numeric(tbl_spacing[i, "y"])} e x: {(tbl_spacing[i, "x"])}')
# Run circ_density
density_result <- circ_density(
radius_values = radius_values,
spacing_x = as.numeric(tbl_spacing[i, "x"]),
spacing_y = as.numeric(tbl_spacing[i, "y"])
)
# Generate plot using circ_plot_density_error
plot <- circ_plot_density_error(
density_result,
colors = c(
"central" = "#e41a1c",
"vertical" = "#377eb8",
"horizontal" = "black",
"quadrante" = "#4daf4a"
),
error_bands = error_bands,
y_limits = c(-60, 60)
)
# Calculate minimum radius for error bands
min_radius_df <- circ_min_radius_for_error(density_result, error_bands)
# Store results, plot, and tibble in the list
results[[iter]] <- list(
density = density_result,
plot = plot,
min_radius = min_radius_df
)
}
# Accessing a specific result
# Example: View plot for the first iteration
print(results[[1]]$plot)
# Example: View the tibble for the first iteration
print(results[[1]]$min_radius)
# Example: View the tibble for the first iteration
print(results[[11]]$min_radius)
View(results)
View(density_result)
View(results)
results[["Iteracao y: 3 e x: 0.5"]]
