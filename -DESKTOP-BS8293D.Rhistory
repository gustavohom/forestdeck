# Plotar os gráficos em layout 2x2
plots <- lapply(results, function(res) res$plot) # Extrai os gráficos da lista
View(plots)
results
View(results)
n_plots <- length(plots)
# Dividir em grupos de 4 e plotar
for (start_idx in seq(1, n_plots, by = 4)) {
end_idx <- min(start_idx + 3, n_plots) # Define o índice final no grupo de 4
grid.arrange(
grobs = plots[start_idx:end_idx],
ncol = 2,
nrow = 2
)
}
library(gridExtra)
library(gridExtra)
# Dividir em grupos de 4 e plotar
for (start_idx in seq(1, n_plots, by = 4)) {
end_idx <- min(start_idx + 3, n_plots) # Define o índice final no grupo de 4
grid.arrange(
grobs = plots[start_idx:end_idx],
ncol = 2,
nrow = 2
)
}
